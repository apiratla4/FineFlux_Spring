# Environment Variables Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit the actual .env file to Git - it contains secrets!

# ====================
# Google Cloud Storage
# ====================
# Bucket name for storing documents
GCS_BUCKET_NAME=pulse-dev

# Service account JSON filename in GCS bucket
GCS_BUCKET_SERVICE_ACCOUNT_FILENAME=fineflux-db8790196c53.json

# Complete service account JSON credentials
# Paste your entire service account JSON here (on one line or multiline)
# Format: {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
GCS_SERVICE_ACCOUNT_JSON=

# ====================
# MongoDB Configuration
# ====================
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=AppName
SPRING_DATA_MONGODB_URI=mongodb+srv://finefluxtesting:finefluxtesting123@finefluxtesting.ttyqwvc.mongodb.net/?appName=FineFluxTesting

# MongoDB database name
SPRING_DATA_MONGODB_DATABASE=Fos_FineFlux

# ====================
# Email Configuration
# ====================
# SMTP server hostname
SPRING_MAIL_HOST=smtp.hostinger.com

# SMTP server port (usually 465 for SSL, 587 for TLS)
SPRING_MAIL_PORT=465

# Email account username
SPRING_MAIL_USERNAME=reset@fineflux.com

# Email account password
SPRING_MAIL_PASSWORD=Reset@!23

# Sender email address
SPRING_MAIL_FROM=reset@fineflux.com

# ====================
# Application Settings
# ====================
# Spring Boot application name
SPRING_APPLICATION_NAME=fineflux

# Logging level (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_ROOT=INFO

# Application timezone (use IANA timezone names)
SPRING_JACKSON_TIMEZONE=Asia/Kolkata

# ====================
# CORS Configuration
# ====================
# Comma-separated list of allowed origins for CORS
# Format: scheme://host or scheme://pattern (e.g., https://*.domain.com)
CORS_ALLOWED_ORIGINS=http://localhost:8081,https://fineflux.com,https://*.fineflux.com

